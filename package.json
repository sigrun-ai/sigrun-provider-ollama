{
	"name": "@sigrun/provider-ollama",
	"version": "0.1.2",
	"description": "Reference sigrun provider plugin: Ollama Cloud (OpenAI-compatible /v1) as a dynamic provider",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node scripts/check-manifest.mjs --expect-name @sigrun/provider-ollama && vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun-provider-ollama.git"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun-provider-ollama/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun-provider-ollama#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "1.3.0 || 1.4.0",
		"@earendil-works/pi-durable": "1.3.0 || 1.4.0"
	}
}
